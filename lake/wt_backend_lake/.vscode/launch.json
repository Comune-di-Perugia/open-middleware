{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lake API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Wisetown.Lake/bin/Debug/net6.0/Wisetown.Lake.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Wisetown.Lake",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Lake Worker",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/Wisetown.Lake.Worker/bin/Debug/net6.0/Wisetown.Lake.Worker.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Wisetown.Lake.Worker",
      "stopAtEntry": false,
      "env": {
        "DOTET_ENVIRONMENT": "Development"
      }
    }
  ]
}